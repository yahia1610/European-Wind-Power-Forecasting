# ============================================================
# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file to GitHub.
# ============================================================

# --- ENTSO-E Transparency Platform API ---
# Register a free API key (web API security token) at:
# https://transparency.entsoe.eu/  ->  "My account" -> "Web API Security Token"
# Docs: https://transparency.entsoe.eu/content/static_content/Static%20content/web%20api/Guide.html
ENTSOE_API_KEY=your_entsoe_api_key_here

# --- Open-Meteo API ---
# Open-Meteo is free for non-commercial use and does NOT require an API key.
# (A key is only needed for their paid plans.) Leave blank unless you have one.
OPENMETEO_API_KEY=

# --- Optional: base URLs (override only if needed) ---
ENTSOE_BASE_URL=https://web-api.tp.entsoe.eu/api
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1